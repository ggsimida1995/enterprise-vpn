{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enterprise VPN",
  "version": "0.2.2",
  "identifier": "com.enterprise.vpn.client",
  "build": {
    "beforeDevCommand": "python3 -m http.server 1420 --bind 127.0.0.1 --directory ../frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["binaries"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "企业内网",
        "width": 520,
        "height": 540,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
